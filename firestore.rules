rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ["Cc6d3YbuqvesWfNP4wzrzFXBg8D2"];
    }

    function validEvent() {
      return request.resource.data.keys().hasAll([
          "title", "description", "location", "date", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "title", "description", "location", "date", "createdAt", "updatedAt"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1500
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 120
        && request.resource.data.date is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin() && validEvent();
      allow delete: if isAdmin();
    }
  }
}
